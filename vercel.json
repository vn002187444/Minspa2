{
  "ignoreCommand": "git diff --quiet HEAD~1 -- . ':(exclude)*.md' ':(exclude)docs/**' ':(exclude).agents/**' ':(exclude).github/**' ':(exclude)LICENSE' 2>/dev/null && exit 0 || exit 1",
  "crons": [],
  "env": {
    "SHARP_IGNORE_GLOBAL_LIBVIPS": "1"
  },
  "redirects": [
    { "source": "/(.*)", "has": [{ "type": "host", "value": "min-nail-hair.vercel.app" }], "destination": "https://spa.minds.io.vn/$1", "permanent": true },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "minhair.vercel.app" }], "destination": "https://spa.minds.io.vn/$1", "permanent": true },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "minnailhair.vn" }], "destination": "https://spa.minds.io.vn/$1", "permanent": true },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "www.minnailhair.vn" }], "destination": "https://spa.minds.io.vn/$1", "permanent": true }
  ]
}
